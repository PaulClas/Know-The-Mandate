{
  "@context": {
    "kym": "https://example.org/kym/v1#",
    "kymid": "https://example.org/kym/id/",
    "prov": "http://www.w3.org/ns/prov#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "label": "rdfs:label",
    "hasPrincipal": {"@id": "kym:hasPrincipal", "@type": "@id"},
    "hasMandatary": {"@id": "kym:hasMandatary", "@type": "@id"},
    "hasPurpose": {"@id": "kym:hasPurpose", "@type": "@id"},
    "hasPermission": {"@id": "kym:hasPermission", "@type": "@id"},
    "authorizesAction": {"@id": "kym:authorizesAction", "@type": "@id"},
    "prohibitsAction": {"@id": "kym:prohibitsAction", "@type": "@id"},
    "appliesToResource": {"@id": "kym:appliesToResource", "@type": "@id"},
    "hasConstraint": {"@id": "kym:hasConstraint", "@type": "@id"},
    "allowedBeneficiary": {"@id": "kym:allowedBeneficiary", "@type": "@id"},
    "imposesObligation": {"@id": "kym:imposesObligation", "@type": "@id"},
    "derivedFromMandate": {"@id": "kym:derivedFromMandate", "@type": "@id"},
    "delegatesTo": {"@id": "kym:delegatesTo", "@type": "@id"},
    "supersedes": {"@id": "kym:supersedes", "@type": "@id"},
    "operatesAgent": {"@id": "kym:operatesAgent", "@type": "@id"},
    "ownsAccount": {"@id": "kym:ownsAccount", "@type": "@id"},
    "governedByPolicy": {"@id": "kym:governedByPolicy", "@type": "@id"},
    "subjectToJurisdiction": {"@id": "kym:subjectToJurisdiction", "@type": "@id"},
    "validFrom": {"@id": "kym:validFrom", "@type": "xsd:dateTime"},
    "validUntil": {"@id": "kym:validUntil", "@type": "xsd:dateTime"},
    "mandateVersion": {"@id": "kym:mandateVersion", "@type": "xsd:integer"},
    "maximumAmount": {"@id": "kym:maximumAmount", "@type": "xsd:integer"},
    "maximumDailyAmount": {"@id": "kym:maximumDailyAmount", "@type": "xsd:integer"},
    "maximumMonthlyAmount": {"@id": "kym:maximumMonthlyAmount", "@type": "xsd:integer"},
    "maximumDelegationDepth": {"@id": "kym:maximumDelegationDepth", "@type": "xsd:integer"},
    "delegationAllowed": {"@id": "kym:delegationAllowed", "@type": "xsd:boolean"},
    "humanApprovalAbove": {"@id": "kym:humanApprovalAbove", "@type": "xsd:integer"},
    "requiredApprovals": {"@id": "kym:requiredApprovals", "@type": "xsd:integer"},
    "currency": "kym:currency",
    "policyVersion": "kym:policyVersion",
    "ontologyVersion": "kym:ontologyVersion",
    "cryptographicDigest": "kym:cryptographicDigest",
    "allowedMerchantCategory": "kym:allowedMerchantCategory",
    "allowedCountry": "kym:allowedCountry"
  }
}

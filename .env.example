# Copy to .env for local use. All values are DEMO-ONLY. Never reuse them anywhere real.
KYM_DATA_DIR=.kym-data
# KYM_DATABASE_URL=postgresql+psycopg://kym:kym-demo-only@localhost:55432/kym
KYM_ISSUER=https://bank.example
# Set when running behind a proxy so DPoP htu validation matches the public URL:
# KYM_PUBLIC_BASE_URL=http://localhost:8000
# Session-signing secret: leave unset to auto-generate a random per-install secret under KYM_DATA_DIR/keys.
# KYM_DEMO_SESSION_SECRET=
# KYM_ENV=demo is the default. Any other value disables no-password sessions and the destructive reset (fail closed).
KYM_ENV=demo
# KYM_RATE_LIMIT_PER_MIN=1200
# KYM_FAILED_AUTH_PER_MIN=20
# KYM_REJECT_EVENTS_PER_MIN=60
KYM_POSTGRES_PASSWORD=kym-demo-only
